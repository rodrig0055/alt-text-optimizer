# Google AI Studio key (aistudio.google.com/apikey). Scores with gemini-embedding-2 and,
# with the default writer, also writes the alt text. The free tier is enough to try it.
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional writers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

SHOP_DESCRIPTION=Acme Florals, an online flower and gift shop
OWN_BRANDS=acme florals,acmeflorals

# Free-tier pacing (requests per minute)
WRITER_RPM=12
EMBED_RPM=80
